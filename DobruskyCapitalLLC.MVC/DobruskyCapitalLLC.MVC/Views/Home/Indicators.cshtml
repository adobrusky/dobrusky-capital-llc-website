@{
    ViewData["Title"] = "Indicators";
}

<!-- Volume Profile Section -->
<section class="p-5 indicator-page-section">
    <div class="container">
        <h2>Volume Profile</h2>
        <div>
            <img src="@Url.Content("~/images/volumeprofile.png")" alt="Volume Profile Indicator" class="indicator-image">
            <div class="indicator-full-description">
                <p>This indicator displays a volume profile (volume by price) that shows both cumulative volume and buy/sell pressure.</p>
                <button disabled class="btn btn-primary indicator-purchase-btn">Purchase</button>
            </div>
        </div>
    </div>
</section>


<!-- Volume Bars Section -->
